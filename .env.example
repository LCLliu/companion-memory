# ── LLM（OpenAI 兼容）────────────────────────────────────────
# 默认使用 DeepSeek；也可以换成智谱等 OpenAI 兼容服务。
# DeepSeek 开放平台：https://platform.deepseek.com/
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_CHAT_MODEL=deepseek-chat
LLM_EXTRACT_MODEL=deepseek-chat
LLM_EXTRACT_FALLBACK=deepseek-chat
LLM_TIMEOUT_MS=60000
# 503/429 等临时故障的总尝试次数；默认 3 次
LLM_RETRY_ATTEMPTS=3

# ── 慢想（纯文本 Phase 1）────────────────────────────────────
# off=关闭；shadow=后台试跑慢想、不影响回复；on=慢想结论参与回复
MIND_MODE=shadow
MIND_MODEL=deepseek-chat

# ── 本地存储 ────────────────────────────────────────────────
DB_PATH=./data/companion.db
PORT=3210

# ── Obsidian 导出 ───────────────────────────────────────────
# pnpm export:obsidian 会把只读记忆地图导出到这里。
OBSIDIAN_VAULT_PATH=D:/ObsidianNotes
# graph=只导出记忆文档，适合看图谱；full=导出会话、反思、意图、想法等完整资料。
OBSIDIAN_EXPORT_SCOPE=graph

# ── 记忆策略 ────────────────────────────────────────────────
EXTRACT_EVERY_TURNS=20
MEMORY_BLOCK_MAX_CHARS=1600
RECALL_TOP_K=3
