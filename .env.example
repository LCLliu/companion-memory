# ── LLM（OpenAI 兼容）────────────────────────────────────────
# 智谱开放平台：https://open.bigmodel.cn/
# 先使用免费的 GLM-4.7-Flash；后期换 DeepSeek 只改这里。
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_CHAT_MODEL=glm-4.7-flash
LLM_EXTRACT_MODEL=glm-4.7-flash
LLM_EXTRACT_FALLBACK=glm-4-flash-250414
LLM_TIMEOUT_MS=60000

# ── 本地存储 ────────────────────────────────────────────────
DB_PATH=./data/companion.db
PORT=3210

# ── 记忆策略 ────────────────────────────────────────────────
EXTRACT_EVERY_TURNS=20
MEMORY_BLOCK_MAX_CHARS=1600
RECALL_TOP_K=3
