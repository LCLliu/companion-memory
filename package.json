{
  "name": "companion-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "长期陪伴型记忆系统 · 文本慢想 Phase 3",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/store.test.ts tests/mind.test.ts tests/maintenance.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
